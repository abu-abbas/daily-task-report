# Salin ke .env (tidak dikomit) lalu sesuaikan. Semua punya default kalau tidak di-set.

# Port HTTP backend.
PORT=3001

# Path file SQLite. Relatif terhadap direktori kerja saat proses dijalankan
# (server/, karena dijalankan lewat "bun --cwd=server run dev"). Default kalau
# kosong: data/app.db di root repo (lihat server/src/db.ts).
DATABASE_PATH=../data/app.db

# Durasi session login dalam milidetik. Default 7 hari.
SESSION_DURATION_MS=604800000

# Nama cookie session.
SESSION_COOKIE=session

# Timezone bisnis (ADR-0032). Mempengaruhi Date/Intl bawaan Bun untuk seluruh proses.
TZ=Asia/Jakarta

# Aktifkan flag Secure pada cookie session (wajib di balik HTTPS produksi).
# NODE_ENV=production
