# Salin ke .env (tidak dikomit) lalu sesuaikan. Semua punya default kalau tidak di-set.

# Port HTTP backend.
PORT=3001

# Path file SQLite. Relatif terhadap direktori kerja saat proses dijalankan
# (server/, karena dijalankan lewat "bun --cwd=server run dev"). Default kalau
# kosong: data/app.db di root repo (lihat server/src/db.ts).
DATABASE_PATH=../data/app.db

# Durasi session login dalam milidetik. Default 7 hari.
SESSION_DURATION_MS=604800000

# Nama cookie session.
SESSION_COOKIE=session

# Timezone bisnis (ADR-0032). Mempengaruhi Date/Intl bawaan Bun untuk seluruh proses.
TZ=Asia/Jakarta

# Aktifkan flag Secure pada cookie session (wajib di balik HTTPS produksi).
# NODE_ENV=production

# Logging aplikasi (ADR-0048), ditulis ke folder logs/ di sebelah file database.
# Batas ukuran satu file log sebelum lanjut ke file bernomor, default 10 MB.
# LOG_MAX_FILE_SIZE_BYTES=10485760
# Berapa hari file log disimpan sebelum dihapus otomatis, default 7.
# LOG_RETENTION_DAYS=7

# GitLab CE self-hosted — host instance (dipakai semua user), untuk impor commit jadi draft
# task realisasi (ADR-0047). Token personal per user disimpan di DB lewat
# PUT /api/me/gitlab-token (arah produksi); GITLAB_SELFHOSTED_PRIVATE_TOKEN di sini cuma
# fallback selama user belum isi token sendiri. Scope token read_api cukup.
# GITLAB_SELFHOSTED_URL=https://gitlab.contoh.internal/
# GITLAB_SELFHOSTED_PRIVATE_TOKEN=
